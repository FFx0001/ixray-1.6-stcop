-- #########################################################################################################
-- 												CHECK BOX
-- #########################################################################################################
class "IXRCheckBox" (CUIStatic)
function IXRCheckBox:__init(check_box_ctrl_name, x, y, alpha, state, _callback, _ref)
	super()
	
	self.is_checked = state
	self.on_change_callback = _callback
	self.check_box_ctrl_name = check_box_ctrl_name .. "_" .. tostring(getNextControllIndex())
	
	local w = ixr_options.controlls_defines.check_box_width
	local h = ixr_options.controlls_defines.check_box_height
	
	self:SetWndSize(vector2():set(x, y))
	self:SetWndPos(vector2():set(w, h))
	
	self.check_box_background = get_options_xml():InitStatic("check_box_background", _ref)
	self.check_box_background:SetWndPos(vector2():set(x, y))
	self.check_box_background:SetWndSize(vector2():set(w, h))
	self.check_box_background:SetTextureColor(GetARGB(alpha, 255, 255, 255))
	self.check_box_background:SetStretchTexture(true)
	self.check_box_background:Show(false)
	
	self.check_box_on = get_options_xml():Init3tButton("check_box_on", _ref)
	self.check_box_on:SetWndPos(vector2():set(x, y))
	self.check_box_on:SetWndSize(vector2():set(w, h))
	self.check_box_on:SetTextureColor(GetARGB(alpha, 255, 255, 255))
	self.check_box_on:SetStretchTexture(true)
	self.check_box_on:Show(false)
	
	self.check_box_off = get_options_xml():Init3tButton("check_box_off", _ref)
	self.check_box_off:SetWndPos(vector2():set(x, y))
	self.check_box_off:SetWndSize(vector2():set(w, h))
	self.check_box_off:SetTextureColor(GetARGB(alpha, 255, 255, 255))
	self.check_box_off:SetStretchTexture(true)
	self.check_box_off:Show(false)
	
	get_menu_ref():Register(self.check_box_off, self.check_box_ctrl_name .. "_check_box_off")
	get_menu_ref():AddCallback(self.check_box_ctrl_name .. "_check_box_off", ui_events.BUTTON_CLICKED, function () self:SwitchState() end, get_menu_ref())
	
	get_menu_ref():Register(self.check_box_on, self.check_box_ctrl_name .. "_check_box_on")
	get_menu_ref():AddCallback(self.check_box_ctrl_name .. "_check_box_on", ui_events.BUTTON_CLICKED, function () self:SwitchState() end, get_menu_ref())
end

function IXRCheckBox:Show(flag)
	self.check_box_background:Show(flag)
	self.check_box_on:Show(flag)
	self.check_box_off:Show(flag)
	
	if flag then
		self:OnChangeState()
	end
end

function IXRCheckBox:SwitchState()
	self:SetState(not self:IsChecked())
end

function IXRCheckBox:OnChangeState()
	self.check_box_on:Show(false)
	self.check_box_off:Show(false)
	
	if self:IsChecked() then
		self.check_box_on:Show(true)
	else
		self.check_box_off:Show(true)
	end
	
	if self.on_change_callback then
		self.on_change_callback(self:IsChecked(), self.check_box_ctrl_name)
	end
end

function IXRCheckBox:SetState(state)
	self.is_checked = state
	self:OnChangeState()
end

function IXRCheckBox:IsChecked()
	return self.is_checked
end

-- #########################################################################################################
-- 												ADDON ITEM
-- #########################################################################################################
class "AddonItem" (CUIListBoxItem)

function AddonItem:__init(wnd_size, icon_path, addon_name, color_addon_name, addon_platform, color_platform, addon_version, color_version, addon_status, color_status, options_variables) super()
	self:SetWndSize(wnd_size)
	
	self.y_offset = 10
	self.addon_display_name = addon_name
	self.options_variables = options_variables
	
	self.addon_background = get_options_xml():InitStatic("addon_background", self)
	self.addon_background:SetStretchTexture(true)
	self.addon_background:SetWndPos(vector2():set(5, 5))
	self.addon_background:SetWndSize(vector2():set(222, 70))
	self.addon_background:SetTextureColor(GetARGB(75, 255, 255, 255))
	
	self.addon_icon = get_options_xml():InitStatic("addon_icon", self)
	self.addon_icon:InitTexture(icon_path)
	self.addon_icon:SetStretchTexture(true)
	self.addon_icon:SetWndPos(vector2():set(14, self.y_offset + 10))
	self.addon_icon:SetWndSize(vector2():set(40, 40))
	self.addon_icon:SetTextureColor(GetARGB(200, 255, 255, 255))
	
	self.addon_name = get_options_xml():InitStatic("ixr_product_sans_16_l", self)
	self.addon_name:SetWndPos(vector2():set(64, self.y_offset))
	self.addon_name:SetWndSize(vector2():set(250, 15))
	self.addon_name:TextControl():SetText(addon_name)
	self.addon_name:TextControl():SetTextColor(color_addon_name)
	
	self.addon_platform = get_options_xml():InitStatic("ixr_product_sans_12_l", self)
	self.addon_platform:SetWndPos(vector2():set(64, self.y_offset + 15 + 2))
	self.addon_platform:SetWndSize(vector2():set(250, 15))
	self.addon_platform:TextControl():SetText("platform: " .. addon_platform)
	self.addon_platform:TextControl():SetTextColor(color_platform)
	
	self.addon_version = get_options_xml():InitStatic("ixr_product_sans_12_l", self)
	self.addon_version:SetWndPos(vector2():set(64, self.y_offset + 15 + 15 + 2 + 2))
	self.addon_version:SetWndSize(vector2():set(250, 15))
	self.addon_version:TextControl():SetText("addon version: " .. addon_version)
	self.addon_version:TextControl():SetTextColor(color_version)
	
	self.addon_status = get_options_xml():InitStatic("ixr_product_sans_12_l", self)
	self.addon_status:SetWndPos(vector2():set(64, self.y_offset + 15 + 15 + 15 + 2 + 2 + 2))
	self.addon_status:SetWndSize(vector2():set(250, 15))
	self.addon_status:TextControl():SetText("addon status: " .. addon_status)
	self.addon_status:TextControl():SetTextColor(color_status)
end

-- #######################################
